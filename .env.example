# Copia este archivo como .env.local para probar localmente con `vercel dev`.
# En producción, estas mismas variables se configuran en el dashboard de Vercel
# (Project Settings -> Environment Variables), nunca se suben al repo.

# JSON completo de la clave de la cuenta de servicio de Google Cloud, en una sola línea.
# (el archivo que descargas al crear la clave — pega su contenido tal cual, como string JSON)
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ID de la hoja de cálculo de Registro de Muestras (el mismo SPREADSHEET_ID de Code.gs).
GOOGLE_SHEET_ID_MUESTRAS=1lbItZAdR7NmAAAB4iykvryPWD4nX13lWwzKEG_ilLLY

# ID de la hoja de cálculo de Inventario (el SPREADSHEET_ID del proyecto InventarioLib).
# Opcional: si se omite, la sincronización de inventario simplemente no ocurre.
GOOGLE_SHEET_ID_INVENTARIO=14lTCBum167F1Muw8AtCBjTosIJ5yGgDNY9uyWjOh55s

# ID de una carpeta de Drive (créala una vez a mano, compártela con el correo de la
# cuenta de servicio con rol Editor) donde se guardan las fotos de perfil.
DRIVE_FOLDER_FOTOS_ID=
